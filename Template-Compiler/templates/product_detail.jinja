<!doctype html>
<html lang="ar">
<head>
    <meta charset="utf-8">
    <title>Product details</title>
    <link rel="stylesheet" href="{{ url_for('static', filename='style.css') }}">
</head>
<body>

<h1>Products Example</h1>

<p>
    <a href="{{ url_for('show_products') }}">All products</a> |
    <a href="{{ url_for('add_product') }}">Add product</a>
</p>

<hr>

<h2>Product details</h2>

<p>
    <img src="{{ product.image }}" alt="{{ product.name }}" width="200">
</p>

<p><strong>Name:</strong> {{ product.name }}</p>
<p><strong>Price:</strong> {{ product.price }}</p>

<p><strong>Details:</strong></p>
<p>{{ product.details }}</p>

<p>
    <a href="{{ url_for('show_products') }}">Back to all products</a>
</p>

<form action="{{ url_for('delete_product', product_id=product.id) }}" method="post" class="inline-form">
    <button type="submit" class="btn-delete">Delete this product</button>
</form>

<script src="{{ url_for('static', filename='script.js') }}"></script>
</body>
</html>
